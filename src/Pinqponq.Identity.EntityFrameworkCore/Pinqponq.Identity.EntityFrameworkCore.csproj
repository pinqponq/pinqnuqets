<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PinqponqTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Version>1.0.0</Version>
    <PackageId>Pinqponq.Identity.EntityFrameworkCore</PackageId>
    <Title>Pinqponq Identity Entity Framework Core</Title>
    <Description>EF Core implementation of the Pinqponq.Identity refresh token store over the application's own DbContext and entity. Ships no entity, table or migration.</Description>
    <PackageTags>$(PackageTags);identity;auth;refresh-token;entity-framework-core;efcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup Condition="'$(IdentityEntityFrameworkCoreVersion)' == ''">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup Condition="'$(IdentityEntityFrameworkCoreVersion)' != ''">
    <PackageReference Include="Microsoft.EntityFrameworkCore" VersionOverride="$(IdentityEntityFrameworkCoreVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" VersionOverride="$(IdentityEntityFrameworkCoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pinqponq.Identity/Pinqponq.Identity.csproj" />
  </ItemGroup>

</Project>
