<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PinqponqTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Version>1.0.0</Version>
    <PackageId>Pinqponq.Hosting.Maintenance</PackageId>
    <Title>Pinqponq Hosting Maintenance</Title>
    <Description>ASP.NET Core maintenance mode set up in one call: a switch read from configuration that takes effect without a restart, a configurable status code, response code and message in the standard error body, an optional Retry-After header, and paths that stay open, such as health checks.</Description>
    <PackageTags>$(PackageTags);maintenance;503;retry-after;aspnetcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pinqponq.Hosting.Maintenance.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pinqponq.ErrorHandling\Pinqponq.ErrorHandling.csproj" />
  </ItemGroup>

</Project>
