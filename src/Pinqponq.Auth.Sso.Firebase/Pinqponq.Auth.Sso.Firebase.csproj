<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PinqponqTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Version>1.0.0</Version>
    <PackageId>Pinqponq.Auth.Sso.Firebase</PackageId>
    <Title>Pinqponq Firebase SSO</Title>
    <Description>Sign-in implementation that validates Firebase ID tokens (Sign in with Apple and Google sign-in through Firebase) with cached Google public keys (IExternalAuthProvider).</Description>
    <PackageTags>$(PackageTags);sso;firebase;firebase-auth;apple-signin;google-signin;id-token;jwt;authentication;auth</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pinqponq.Auth.Sso.Abstractions/Pinqponq.Auth.Sso.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pinqponq.Auth.Sso.Firebase.Tests" />
  </ItemGroup>

</Project>
