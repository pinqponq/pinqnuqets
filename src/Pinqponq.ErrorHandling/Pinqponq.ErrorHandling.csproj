<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PinqponqTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Pinqponq.ErrorHandling</PackageId>
    <Title>Pinqponq Error Handling</Title>
    <Description>Global exception middleware plus a standard error response contract; log output uses Pinqloq's structured format (correlation/trace id, field names).</Description>
    <PackageTags>$(PackageTags);error-handling;exception;middleware;aspnetcore;error-response;correlation-id</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
