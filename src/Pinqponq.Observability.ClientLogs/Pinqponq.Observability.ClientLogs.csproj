<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PinqponqTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Version>1.0.0</Version>
    <PackageId>Pinqponq.Observability.ClientLogs</PackageId>
    <Title>Pinqponq Observability Client Logs</Title>
    <Description>Server end of pinqloq-kmp: endpoints that take logs from a mobile or web app (one per request, or a batch) and write them to Pinqloq as device logs, with optional size and count limits, key redaction and an enricher hook for product fields.</Description>
    <PackageTags>$(PackageTags);observability;logging;pinqloq;client-logs;aspnetcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pinqponq.Observability.ClientLogs.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pinqponq.Observability\Pinqponq.Observability.csproj" />
  </ItemGroup>

</Project>
