<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PinqponqTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Pinqponq.Auth.Sso.Google</PackageId>
    <Description>Google OAuth2/OIDC id_token doğrulaması ile giriş implementasyonu (IExternalAuthProvider).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pinqponq.Auth.Sso.Abstractions/Pinqponq.Auth.Sso.Abstractions.csproj" />
  </ItemGroup>

</Project>
