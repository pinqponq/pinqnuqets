<Project>

  <!-- Pack each project's README.md and the shared package icon. Evaluated after
       the project body so $(IsPackable) is known. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets\img\pinqnuqets-dark.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
