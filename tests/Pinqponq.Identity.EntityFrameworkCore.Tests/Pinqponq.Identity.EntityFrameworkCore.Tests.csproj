<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PinqponqTargetFrameworks)</TargetFrameworks>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <ProjectReference Include="../../src/Pinqponq.Identity.EntityFrameworkCore/Pinqponq.Identity.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../Pinqponq.TestSupport/Pinqponq.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(IdentityEntityFrameworkCoreVersion)' == ''">
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup Condition="'$(IdentityEntityFrameworkCoreVersion)' != ''">
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" VersionOverride="$(IdentityNpgsqlEntityFrameworkCoreVersion)" />
    <PackageReference Include="Npgsql" VersionOverride="$(IdentityNpgsqlVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" VersionOverride="$(IdentityEntityFrameworkCoreVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" VersionOverride="$(IdentityEntityFrameworkCoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Pinqponq.Identity.Tests/RefreshTokens/RefreshTokenServiceContractTests.cs" Link="RefreshTokens/RefreshTokenServiceContractTests.cs" />
  </ItemGroup>

</Project>
