<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PinqponqTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Pinqponq.Auth.Totp</PackageId>
    <Title>Pinqponq TOTP</Title>
    <Description>RFC 6238 TOTP-based 2FA: secret generation, otpauth:// provisioning URI, and code validation. Compatible with Google/Microsoft Authenticator.</Description>
    <PackageTags>$(PackageTags);totp;2fa;mfa;rfc6238;authenticator;otp;auth;security</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
