<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PinqponqTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Version>1.0.0</Version>
    <PackageId>Pinqponq.Billing.RevenueCat</PackageId>
    <Title>Pinqponq Billing RevenueCat</Title>
    <Description>RevenueCat webhook handling: payload model, Authorization header verification and event dispatch, with persistence left to the consuming product.</Description>
    <PackageTags>$(PackageTags);revenuecat;billing;subscription;webhook</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
