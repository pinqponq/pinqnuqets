<Project>

  <!-- Pack the shared repository README into every packable project. Evaluated
       after the project body so $(IsPackable) is known. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
