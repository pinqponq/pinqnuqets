<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PinqponqTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Version>1.0.0</Version>
    <PackageId>Pinqponq.Observability</PackageId>
    <Title>Pinqponq Observability</Title>
    <Description>Pinqloq logging for ASP.NET Core: one structured record per request (redacted request/response bodies, route-based event names, error detail from Pinqponq.ErrorHandling), an ILogService for application and job logs with stack trace trimming, and a client-log relay endpoint.</Description>
    <PackageTags>$(PackageTags);observability;logging;pinqloq;request-logging;middleware;aspnetcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="pinqloq" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pinqponq.Observability.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pinqponq.Contracts\Pinqponq.Contracts.csproj" />
    <ProjectReference Include="..\Pinqponq.Observability.Abstractions\Pinqponq.Observability.Abstractions.csproj" />
  </ItemGroup>

</Project>
