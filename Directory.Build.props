<Project>

  <!-- Supported target frameworks: .NET 8 and every release after it. Projects opt in
       with <TargetFrameworks>$(PinqponqTargetFrameworks)</TargetFrameworks>, so adding the
       next runtime is a single edit here. The Playground opts out deliberately — see its
       csproj. -->
  <PropertyGroup>
    <PinqponqTargetFrameworks>net8.0;net9.0;net10.0</PinqponqTargetFrameworks>
  </PropertyGroup>

  <!-- Shared compiler settings for every project in the repository. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS1591: missing XML doc comment. Public API is documented, but we do
         not want an incidental gap to fail the build. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Every target framework compiles the same source, so the oldest one is the real
       language ceiling. Pinning it per framework makes the build produce the same result
       on any SDK: without this, `latest` silently compiles the net8.0 leg with whatever
       newer compiler happens to be installed, and syntax that net8.0 consumers' toolchains
       reject builds green here. That is exactly how the CS0121 break in Pinqponq.Mail
       reached master. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <LangVersion>13.0</LangVersion>
  </PropertyGroup>

  <!-- Shared package metadata. Individual projects opt in with IsPackable. -->
  <PropertyGroup>
    <Authors>Pinqponq</Authors>
    <Company>Pinqponq</Company>
    <Product>Pinqponq Nugets</Product>
    <Copyright>Copyright (c) Pinqponq 2026</Copyright>
    <RepositoryUrl>https://github.com/pinqponq/pinqnuqets</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/pinqponq/pinqnuqets</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>pinqnuqets-dark.png</PackageIcon>
    <!-- Tags shared by every package; each project appends its own via $(PackageTags). -->
    <PackageTags>pinqponq;dotnet;backend;infrastructure</PackageTags>
    <PackageReleaseNotes>https://github.com/pinqponq/pinqnuqets/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Source Link + symbol packages for open-source debugging on nuget.org.
       .NET SDK embeds GitHub Source Link when PublishRepositoryUrl is set. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
