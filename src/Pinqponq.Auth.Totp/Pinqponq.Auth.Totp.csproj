<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Pinqponq.Auth.Totp</PackageId>
    <Title>Pinqponq TOTP</Title>
    <Description>RFC 6238 TOTP tabanlı 2FA: secret üretimi, otpauth:// provisioning URI ve kod doğrulama. Google/Microsoft Authenticator uyumlu.</Description>
    <PackageTags>$(PackageTags);totp;2fa;mfa;rfc6238;authenticator;otp;auth;security</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
