<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Pinqponq.Auth.Sso.Abstractions</PackageId>
    <Title>Pinqponq SSO Abstractions</Title>
    <Description>Dış kimlik sağlayıcıların (Google, vb.) ortak sözleşmesi: IExternalAuthProvider ve taşıdığı modeller. Sağlayıcı implementasyon paketlerinin temeli.</Description>
    <PackageTags>$(PackageTags);sso;oauth;oidc;authentication;external-auth;abstractions;auth</PackageTags>
  </PropertyGroup>

</Project>
