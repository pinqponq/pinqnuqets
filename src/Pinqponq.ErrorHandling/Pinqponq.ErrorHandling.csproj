<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PinqponqTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Pinqponq.ErrorHandling</PackageId>
    <Title>Pinqponq Error Handling</Title>
    <Description>Global exception middleware + standart hata response contract; log çıktısı Pinqloq'un beklediği yapılandırılmış formatta (correlation/trace id, alan adları) üretilir.</Description>
    <PackageTags>$(PackageTags);error-handling;exception;middleware;aspnetcore;error-response;correlation-id</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
