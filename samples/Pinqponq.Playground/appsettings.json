{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      // The console's own request plumbing would otherwise bury the package logs that are
      // the point of this app. Raise to Information to watch every HTTP call.
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "Kestrel": {
    "Endpoints": {
      "Http": {
        // Loopback only: this console accepts secrets and opens outbound connections.
        "Url": "http://127.0.0.1:5199"
      }
    }
  },

  "Playground": {
    "LogBufferCapacity": 5000,
    "ScenarioTimeoutSeconds": 60,

    // Supply an endpoint here to use an existing server instead of a container. That
    // service is then reported as "Harici" and never provisioned.
    //   postgres / redis / mongo / mssql : connection string
    //   rabbitmq                         : amqp://user:pass@host:port
    //   mailhog                          : host:smtpPort:apiPort
    // Example: "redis": "localhost:6379"
    "ExternalServices": {}
  }
}
