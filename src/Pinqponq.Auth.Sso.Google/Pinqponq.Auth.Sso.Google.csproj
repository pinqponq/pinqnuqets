<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PinqponqTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Pinqponq.Auth.Sso.Google</PackageId>
    <Title>Pinqponq Google SSO</Title>
    <Description>Sign-in implementation via Google OAuth2/OIDC id_token validation (IExternalAuthProvider).</Description>
    <PackageTags>$(PackageTags);sso;google;oauth2;oidc;google-signin;id-token;authentication;auth</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pinqponq.Auth.Sso.Abstractions/Pinqponq.Auth.Sso.Abstractions.csproj" />
  </ItemGroup>

</Project>
