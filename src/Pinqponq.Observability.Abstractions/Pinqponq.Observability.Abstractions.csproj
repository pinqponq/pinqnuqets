<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PinqponqTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Pinqponq.Observability</RootNamespace>

    <Version>1.0.0</Version>
    <PackageId>Pinqponq.Observability.Abstractions</PackageId>
    <Title>Pinqponq Observability Abstractions</Title>
    <Description>ILogService, the logging contract of Pinqponq.Observability, without any dependency, so domain and application layers can log without referencing ASP.NET Core or the Pinqloq client.</Description>
    <PackageTags>$(PackageTags);observability;logging;pinqloq;abstractions</PackageTags>
  </PropertyGroup>

</Project>
