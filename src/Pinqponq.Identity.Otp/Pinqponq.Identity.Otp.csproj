<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PinqponqTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Pinqponq.Identity.Otp</PackageId>
    <Title>Pinqponq Identity OTP</Title>
    <Description>One-time code send/verify flow over email or SMS; channel routing (mail/sms) lives in the package. Storage interface is left to the consumer.</Description>
    <PackageTags>$(PackageTags);otp;one-time-password;2fa;mfa;email;sms;verification;identity;auth</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pinqponq.Sms/Pinqponq.Sms.csproj" />
    <ProjectReference Include="../Pinqponq.Mail/Pinqponq.Mail.csproj" />
  </ItemGroup>

</Project>
