<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PinqponqTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Pinqponq.LiveKit.Server</PackageId>
    <Title>Pinqponq LiveKit Server</Title>
    <Description>LiveKit server API client: access token issuing, RoomService calls over Twirp JSON, and webhook signature verification. Does not require a Protobuf/gRPC toolchain.</Description>
    <PackageTags>$(PackageTags);livekit;webrtc;access-token;room-service;webhook;twirp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <!-- System.Buffers.Text.Base64Url is in the BCL from .NET 9; net8.0 takes Microsoft's backport. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Bcl.Memory" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pinqponq.LiveKit.Server.Tests" />
  </ItemGroup>

</Project>
