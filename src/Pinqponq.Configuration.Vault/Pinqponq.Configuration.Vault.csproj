<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PinqponqTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Version>1.0.0</Version>
    <PackageId>Pinqponq.Configuration.Vault</PackageId>
    <Title>Pinqponq Configuration Vault</Title>
    <Description>HashiCorp Vault configuration provider: loads one KV v2 record shaped like appsettings.json into IConfiguration at startup. Resolves the token the way the Vault CLI does (configuration, VAULT_TOKEN, ~/.vault-token).</Description>
    <PackageTags>$(PackageTags);vault;hashicorp-vault;configuration;secrets;kv-v2;appsettings</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pinqponq.Configuration.Vault.Tests" />
  </ItemGroup>

</Project>
