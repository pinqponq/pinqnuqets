<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PinqponqTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Version>1.0.0</Version>
    <PackageId>Pinqponq.Identity.Otp.Mail</PackageId>
    <Title>Pinqponq Identity OTP Mail</Title>
    <Description>Branded HTML email for the one-time codes of Pinqponq.Identity.Otp: texts per language with an English default, the code lifetime taken from OtpOptions, a plain-text version and a replaceable layout.</Description>
    <PackageTags>$(PackageTags);otp;one-time-password;verification;email;mail;identity</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pinqponq.Identity.Otp\Pinqponq.Identity.Otp.csproj" />
    <ProjectReference Include="..\Pinqponq.Mail\Pinqponq.Mail.csproj" />
  </ItemGroup>

</Project>
